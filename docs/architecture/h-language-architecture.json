        "hc run — tree-walking interpreter (default, full language)",
        "hc run --ir — IR reference interpreter",
        "hc run <file.hbc> — bytecode VM (reuses run_ir)",
        "hc run <dir> — package mode, same-namespace siblings (ADR-0031)",
        "hc build — LLVM native (builtin subset)",
        "hc fmt / lint / doc / new / pkg / cc / lsp"
      ]
    },
