      "title": "Compiler Pipeline",
      "items": [
        "Source → lexer → token stream",
        "Parser builds an AST",
        "Semantic: type checking, ownership, error-set inference",
        "IR lowers typed AST (single semantic source)",
        "Bytecode codegen → HBC2 VM",
        "LLVM codegen → native via zig cc"
      ]
